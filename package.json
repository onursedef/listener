{
  "name": "@irukaga/listener",
  "version": "0.1.0",
  "description": "Reusable agent policies, skills, and AGENTS.md generation",
  "type": "module",
  "bin": {
    "listener": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">= 1.3.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --target=bun --format=esm --outfile=dist/cli.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build",
    "publish:npm": "bun publish",
    "postinstall": "akit setup"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
