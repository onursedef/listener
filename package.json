{
  "name": "@irukaga/listener",
  "version": "0.2.0",
  "description": "Reusable agent policies, skills, and AGENTS.md generation",
  "type": "module",
  "bin": {
    "listener": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "agents-md",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onursedef/listener.git"
  },
  "homepage": "https://github.com/onursedef/listener#readme",
  "bugs": {
    "url": "https://github.com/onursedef/listener/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --target=bun --format=esm --outfile=dist/cli.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build",
    "publish:npm": "bun publish --access public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
